# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Optional in production: the exact public origin of the API
# BETTER_AUTH_URL=https://api.yourdomain.com

# Comma-separated E.164 numbers that should receive the admin role
ADMIN_PHONES=+919876543210

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use a sending number in E.164, or a Messaging Service SID (MG...)
TWILIO_PHONE_NUMBER=+15551234567

# Optional: API origin for native builds (EAS / production)
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
