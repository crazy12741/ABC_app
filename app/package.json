{
  "name": "american-burger-club",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --tunnel --port 4000 --max-workers 2",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run lib/seed.ts",
    "db:verify": "bun run scripts/verify-backend.ts",
    "verify:guards": "bun run scripts/verify-auth-guards.ts",
    "verify:orders": "bun run scripts/verify-orders.ts",
    "verify:all": "bun run typecheck && bun run db:verify && bun run verify:guards && bun run verify:orders",
    "auth:generate": "bun x auth@latest generate --config lib/auth.ts --output lib/auth-schema.ts -y",
    "deploy": "expo export -p web && wrangler deploy",
    "cf:preview": "expo export -p web && wrangler dev"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.25",
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@neondatabase/serverless": "^1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "expo": "^54.0.0",
    "expo-blur": "~15.0.3",
    "expo-camera": "~17.0.1",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.2",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.1",
    "expo-haptics": "~15.0.1",
    "expo-image": "~3.0.8",
    "expo-linear-gradient": "~15.0.1",
    "expo-linking": "~8.0.2",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.1",
    "expo-secure-store": "~15.0.8",
    "expo-server": "~1.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.1",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.1",
    "expo-web-browser": "~15.0.1",
    "lucide-react-native": "^0.475.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.1.10",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "typescript": "~5.9.2",
    "wrangler": "^4.167.0"
  }
}
